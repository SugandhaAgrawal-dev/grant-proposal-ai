# =============================================================================
# Healthcare Grant Proposal Generator — Environment Variables
# =============================================================================
# Copy to .env and fill in your values:  cp .env.example .env

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/grant_proposal_db

# ── LLM Provider Switch ───────────────────────────────────────────────────────
# Options: ollama | openai | claude | vertex
DEFAULT_LLM_PROVIDER=vertex

# Ollama (local — no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120

# OpenAI (cloud)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# Anthropic Claude (cloud)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-opus-4-5

# Google Vertex AI / Gemini (cloud — HIPAA-eligible)
# Authentication: set GOOGLE_APPLICATION_CREDENTIALS or run:
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_LLM_MODEL=gemini-1.5-pro-002
# Options: gemini-1.5-pro-002 | gemini-1.5-flash-002 | gemini-2.0-flash-001
VERTEX_EMBED_MODEL=text-embedding-004
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Redis (Celery task queue) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── File Storage ──────────────────────────────────────────────────────────────
MEDIA_ROOT=media/
MAX_UPLOAD_SIZE_MB=50

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
